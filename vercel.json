{
  "rewrites": [
    {
      "source": "/master",
      "destination": "/master.html"
    }
  ],
  "headers": [
    {
      "source": "/master",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
